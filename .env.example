# Copy to .env for local runs. On Render, set these in the dashboard (render.yaml prompts for the secret ones).
GEMMA_API_KEY=            # https://aistudio.google.com/apikey
TELEGRAM_BOT_TOKEN=       # talk to @BotFather → /newbot
FRIEND_NAME=Ben
FRIEND_TIMEZONE=Asia/Kolkata
# Optional
# GEMMA_MODEL=gemma-4-26b-a4b-it
# GEMMA_FALLBACK_MODEL=gemma-4-31b-it
# DATABASE_URL=postgresql://...      (defaults to a local SQLite file)
# SECRET_KEY=...                     (signs links; Render generates one)
# ADMIN_KEY=...                      (unlocks /setup; defaults to dev-admin locally)
# HELPLINE_TEXT=...                  (what Ben sees if things get really hard)
# REPO_URL=https://github.com/you/still-here
